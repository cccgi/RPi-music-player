<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!--
  Advertises the SMB share over mDNS/Bonjour so it shows up under
  "Network" / in Finder's sidebar as rpi-touch.local without needing a
  manual \\rpi-touch\Music or smb://rpi-touch.local/Music path typed in.
  Installed by install.sh to /etc/avahi/services/smb.service.
-->
<service-group>
  <name replace-wildcards="yes">%h</name>
  <service>
    <type>_smb._tcp</type>
    <port>445</port>
  </service>
</service-group>
