#!/usr/bin/env bash
#
# rpi-player-doctor — check every layer of the stack and say what is wrong.
#
# Written because this build has many independent failure modes (ModemManager,
# WirePlumber holding the DAC, missing groups, absent PipeWire sinks) that all
# present as the same symptom: "it doesn't work". Run this first.
#
set -uo pipefail

DEST=/opt/rpi-player
PASS=0; FAIL=0; WARN=0

ok()   { printf '  \033[1;32m✓\033[0m %s\n' "$*"; PASS=$((PASS+1)); }
bad()  { printf '  \033[1;31m✗\033[0m %s\n' "$*"; FAIL=$((FAIL+1)); }
warn() { printf '  \033[1;33m!\033[0m %s\n' "$*"; WARN=$((WARN+1)); }
hdr()  { printf '\n\033[1;34m%s\033[0m\n' "$*"; }
hint() { printf '      \033[2m%s\033[0m\n' "$*"; }

hdr "TourBox"
if [[ -e /dev/tourbox ]]; then
    ok "/dev/tourbox exists -> $(readlink -f /dev/tourbox)"
elif compgen -G "/dev/ttyACM*" >/dev/null; then
    warn "no /dev/tourbox symlink, but $(ls /dev/ttyACM* | tr '\n' ' ')exists"
    hint "udev rule missing? sudo cp system/udev/99-tourbox.rules /etc/udev/rules.d/"
    hint "then: sudo udevadm control --reload-rules && replug the device"
else
    bad "no TourBox device found"
    hint "check the cable is a DATA cable, then: dmesg | tail -20"
fi

if systemctl is-active --quiet ModemManager 2>/dev/null; then
    warn "ModemManager is running — it probes CDC-ACM ports and steals bytes"
    hint "sudo apt purge modemmanager   (or rely on the udev ID_MM_DEVICE_IGNORE rule)"
else
    ok "ModemManager is not running"
fi

if [[ -e /dev/tourbox ]] && command -v fuser >/dev/null; then
    holder=$(fuser /dev/tourbox 2>/dev/null | tr -d ' ')
    if [[ -n "$holder" ]]; then
        proc=$(ps -o comm= -p "$holder" 2>/dev/null || echo "pid $holder")
        if [[ "$proc" == *python* ]]; then
            ok "port held by our daemon ($proc)"
        else
            bad "port held by unexpected process: $proc (pid $holder)"
        fi
    else
        warn "nothing is holding /dev/tourbox (daemon not running?)"
    fi
fi

hdr "Stream Deck"
if lsusb 2>/dev/null | grep -qi '0fd9:'; then
    ok "Elgato device present: $(lsusb | grep -i '0fd9:' | head -1 | cut -d' ' -f7-)"
    if [[ -f /etc/udev/rules.d/99-streamdeck.rules ]]; then
        ok "udev rule installed"
    else
        bad "99-streamdeck.rules missing — the daemon will get a permissions error"
    fi
else
    warn "no Stream Deck detected (optional hardware)"
fi

hdr "Groups for ${SUDO_USER:-$USER}"
for grp in dialout plugdev audio; do
    if id -nG "${SUDO_USER:-$USER}" | tr ' ' '\n' | grep -qx "$grp"; then
        ok "member of $grp"
    else
        bad "NOT in group $grp"
        hint "sudo usermod -aG $grp ${SUDO_USER:-$USER}   (then log out and back in)"
    fi
done

hdr "MPD"
if systemctl is-active --quiet mpd; then
    ok "mpd.service is running"
    if command -v mpc >/dev/null; then
        if mpc status >/dev/null 2>&1; then
            ok "responding: $(mpc status | head -1)"
            songs=$(mpc stats 2>/dev/null | awk '/Songs/ {print $2}')
            if [[ "${songs:-0}" -gt 0 ]]; then
                ok "library has $songs songs"
            else
                warn "library is empty — copy music in, then: mpc update"
            fi
        else
            bad "mpc cannot talk to MPD"
            hint "check bind_to_address in /etc/mpd.conf; try: journalctl -u mpd -n 30"
        fi

        echo "    outputs:"
        mpc outputs 2>/dev/null | sed 's/^/      /' || echo "      (none)"
    fi
else
    bad "mpd.service is not running"
    hint "journalctl -u mpd -n 40 --no-pager"
fi

hdr "Audio devices"
if command -v aplay >/dev/null; then
    cards=$(aplay -l 2>/dev/null | grep -c '^card' || echo 0)
    if [[ "$cards" -gt 0 ]]; then
        ok "$cards ALSA playback device(s)"
        aplay -l 2>/dev/null | grep '^card' | sed 's/^/      /'
    else
        bad "no ALSA playback devices"
    fi
fi

hdr "PipeWire"
if command -v wpctl >/dev/null && wpctl status >/dev/null 2>&1; then
    ok "PipeWire is responding"
    echo "    sinks:"
    wpctl status 2>/dev/null | awk '/Sinks:/,/^ *$/' | sed 's/^/      /' | head -12

    if wpctl status 2>/dev/null | grep -qi 'bluez_output'; then
        ok "a Bluetooth sink is connected"
    else
        warn "no Bluetooth sink — the BT route will show as unavailable"
        hint "bluetoothctl connect <MAC>"
    fi

    if wpctl status 2>/dev/null | grep -qi 'raop'; then
        ok "an AirPlay (RAOP) sink was discovered"
    else
        warn "no AirPlay sink — the AirPlay route will show as unavailable"
        hint "check module-raop-discover is loaded and you are on the same subnet"
    fi
else
    warn "wpctl not responding (PipeWire may not be running for this user)"
    hint "systemctl --user status pipewire wireplumber"
fi

hdr "WirePlumber / DAC exclusivity"
if [[ -f /etc/wireplumber/wireplumber.conf.d/51-mpd-dac-ignore.conf ]]; then
    ok "DAC exclusion rule installed"
    if grep -q 'alsa_card.usb-.*Audio' /etc/wireplumber/wireplumber.conf.d/51-mpd-dac-ignore.conf; then
        warn "rule still has the PLACEHOLDER match — edit it for your DAC"
        hint "wpctl status, then set device.name in that file"
    fi
else
    warn "no DAC exclusion rule — MPD and PipeWire may fight over the card"
fi

hdr "Sharing"
for svc in smbd nmbd avahi-daemon; do
    if systemctl is-active --quiet "$svc"; then
        ok "$svc is running"
    else
        bad "$svc is not running"
    fi
done
if [[ -f /etc/avahi/services/smb.service ]]; then
    ok "mDNS SMB advertisement installed"
else
    warn "no /etc/avahi/services/smb.service — Finder discovery will be poor"
fi

hdr "Player services"
for svc in tourbox-player streamdeck-player; do
    state=$(systemctl is-active "$svc" 2>/dev/null || echo inactive)
    if [[ "$state" == active ]]; then
        restarts=$(systemctl show -p NRestarts --value "$svc" 2>/dev/null || echo 0)
        if [[ "${restarts:-0}" -gt 3 ]]; then
            warn "$svc is running but has restarted $restarts times — it is crash-looping"
            hint "journalctl -u $svc -n 50 --no-pager"
        else
            ok "$svc is active"
        fi
    else
        bad "$svc is $state"
        hint "journalctl -u $svc -n 40 --no-pager"
    fi
done

hdr "Keymap"
KEYMAP="$DEST/etc/keymap.toml"
if [[ -f "$KEYMAP" ]]; then
    # Accept either provenance marker: the capture tool stamps "GENERATED by
    # tourbox-capture", a hand-written verified map is marked "VERIFIED ON
    # HARDWARE". Checking only for the former reported a verified keymap as
    # untrustworthy.
    if grep -qE 'GENERATED by tourbox-capture|VERIFIED ON HARDWARE' "$KEYMAP"; then
        verified=$(grep -c '# VERIFIED' "$KEYMAP" 2>/dev/null || echo 0)
        unverified=$(grep -c '# UNVERIFIED' "$KEYMAP" 2>/dev/null || echo 0)
        ok "keymap carries a hardware-verification marker"
        [[ "$verified" -gt 0 ]]   && printf '      %s code(s) marked VERIFIED\n' "$verified"
        if [[ "$unverified" -gt 0 ]]; then
            warn "$unverified code(s) still marked UNVERIFIED"
            hint "see docs/TOURBOX-NOTES.md for what is outstanding"
        fi
    else
        warn "keymap has no verification marker — codes may be guesses"
        hint "$DEST/venv/bin/python $DEST/bin/tourbox-capture --learn --out /tmp/keymap.toml"
    fi
else
    bad "keymap.toml missing at $KEYMAP"
fi

hdr "Boot time"
if command -v systemd-analyze >/dev/null; then
    systemd-analyze time 2>/dev/null | sed 's/^/  /' || true
fi

printf '\n\033[1m%d passed, %d warnings, %d failed\033[0m\n' "$PASS" "$WARN" "$FAIL"
[[ "$FAIL" -eq 0 ]] || exit 1
