#!/usr/bin/env python3
"""AVRCP ↔ MPD bridge — hardened edition.

Registers an MPRIS media-player object with BlueZ so that connected Bluetooth devices
acting as AVRCP Controllers (Bose QC45 headphone buttons, Toyota Camry
steering wheel) can control MPD playback.  Also pushes current track
metadata back to BlueZ so devices that support AVRCP metadata can display
song title/artist/album.

Hardening over the initial version:
  • Watches for device connect/disconnect via BlueZ D-Bus signals and forces
    a full metadata push 2 s after each connect (AVRCP session needs a moment
    to fully establish before it can accept metadata).
  • Watches for bluetoothd disappear/reappear and re-registers the player
    automatically, so a bluetoothd restart does not permanently break AVRCP.
  • 30 s heartbeat re-push as a belt-and-suspenders fallback for any missed
    PropertiesChanged signals.
  • Position is only pushed on track/state changes, not on every idle tick
    (continuous position spam confused the Camry head unit and caused it to
    drop AVRCP metadata periodically).
  • Logging goes to stdout → journald with a syslog identifier, so
    `journalctl --user -u avrcp-bridge` shows useful output.

Signal flow:
  BT device (AVRCP Controller)
      │ AVRCP PASSTHROUGH
      ▼
    BlueZ  (routes to our registered /org/rpi_player/mpd object)
      │ org.mpris.MediaPlayer2.Player method calls
      ▼
  this daemon  ──► MPD  (python-mpd2)

Metadata push:
  MPD ──idle──► this daemon ──PropertiesChanged──► BlueZ ──AVRCP──► device display
                              ──on connect (2s delayed)──► BlueZ
                              ──every 30 s heartbeat──────► BlueZ

Run as user 'rpi'.  Uses system Python3 + system dbus-python + system
python-mpd2.  Not compatible with the player venv (dbus-python not in venv).
"""

from __future__ import annotations

import logging
import os
import sys
import threading
import time

# Allow importing from the player package even when invoked as a plain script.
# The package lives at /opt/rpi-player/player/; sys.path needs /opt/rpi-player.
_PLAYER_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if _PLAYER_ROOT not in sys.path:
    sys.path.insert(0, _PLAYER_ROOT)

try:
    from player.id3_fallback import enrich as _id3_enrich
    _HAS_ID3_FALLBACK = True
except ImportError:
    _HAS_ID3_FALLBACK = False

import dbus
import dbus.service
import dbus.mainloop.glib
from gi.repository import GLib
import mpd as _mpd

# ---- logging ----------------------------------------------------------------
# Write to stdout so the systemd user unit (StandardOutput=journal) routes it
# to journald and `journalctl --user -u avrcp-bridge` shows the output.
logging.basicConfig(
    stream=sys.stdout,
    level=logging.INFO,
    format="%(asctime)s %(levelname)-8s %(message)s",
    datefmt="%H:%M:%S",
)
LOG = logging.getLogger("avrcp-bridge")

# ---- constants --------------------------------------------------------------
_BLUEZ_SVC          = "org.bluez"
_BLUEZ_MEDIA_IFACE  = "org.bluez.Media1"
_MPRIS_PLAYER_IFACE = "org.mpris.MediaPlayer2.Player"
_DBUS_PROPS_IFACE   = "org.freedesktop.DBus.Properties"

_ADAPTER_PATH  = "/org/bluez/hci0"
_PLAYER_PATH   = "/org/rpi_player/mpd"
_MPD_HOST      = "localhost"
_MPD_PORT      = 6600

# When a device connects A2DP (from the device side, not initiated by us),
# BlueZ refuses the device's inbound AVCTP (AVRCP control channel) attempt
# with "Refusing unexpected connect" — it only accepts AVCTP sessions it
# initiates itself. The fix: call ConnectProfile after A2DP connects so
# BlueZ initiates AVCTP from our side.
_AVRCP_CONTROLLER_UUID    = "0000110e-0000-1000-8000-00805f9b34fb"

# Retry schedule (ms) for ConnectProfile after a device connects.
# Multiple attempts handle the race where A2DP hasn't fully settled yet.
_AVRCP_CONNECT_DELAYS_MS  = [2000, 5000, 12000]  # 2 s, 5 s, 12 s after connect

# Delay between a device connecting and our first metadata push.
# AVRCP needs a moment to fully negotiate before it will accept our metadata.
_RECONNECT_PUSH_DELAY_MS = 4000

# Heartbeat: re-push all metadata unconditionally this often (ms).
_HEARTBEAT_INTERVAL_MS = 30_000


# =============================================================================
# MediaPlayer D-Bus object — BlueZ calls these methods on AVRCP commands
# =============================================================================

class _MediaPlayer(dbus.service.Object):

    def __init__(self, bus: dbus.SystemBus, path: str) -> None:
        dbus.service.Object.__init__(self, bus, path)
        # Shadow of what we last pushed to BlueZ. Used to diff-push.
        # Position is excluded from diff: we only push it with track changes.
        self._props: dict = {
            "PlaybackStatus": dbus.String("Stopped"),
            "Position": dbus.Int64(0),
            "Metadata": dbus.Dictionary({}, signature="sv"),
            "Shuffle": dbus.Boolean(False),
            "LoopStatus": dbus.String("None"),
            "CanPlay": dbus.Boolean(True),
            "CanPause": dbus.Boolean(True),
            "CanGoNext": dbus.Boolean(True),
            "CanGoPrevious": dbus.Boolean(True),
            "CanControl": dbus.Boolean(True),
            "Identity": dbus.String("MPD"),
        }
        # Separate tracking for whether the track changed (triggers Position push)
        self._last_song_id: str = ""
        # Seek detection: track elapsed and wall-clock time at last Position push
        self._last_push_elapsed: float = 0.0
        self._last_push_time: float = 0.0  # time.monotonic()

    # -------------------------------------------------------------------------
    # AVRCP control commands → MPD
    # -------------------------------------------------------------------------

    @dbus.service.method(_MPRIS_PLAYER_IFACE)
    def Play(self) -> None:
        LOG.info("AVRCP → Play")
        _mpd_cmd("play")

    @dbus.service.method(_MPRIS_PLAYER_IFACE)
    def Pause(self) -> None:
        LOG.info("AVRCP → Pause")
        _mpd_cmd("pause", 1)

    @dbus.service.method(_MPRIS_PLAYER_IFACE)
    def Stop(self) -> None:
        LOG.info("AVRCP → Stop")
        _mpd_cmd("stop")

    @dbus.service.method(_MPRIS_PLAYER_IFACE)
    def Next(self) -> None:
        LOG.info("AVRCP → Next")
        _mpd_cmd("next")

    @dbus.service.method(_MPRIS_PLAYER_IFACE)
    def Previous(self) -> None:
        LOG.info("AVRCP → Previous")
        _mpd_cmd("previous")

    @dbus.service.method(_MPRIS_PLAYER_IFACE, in_signature="x")
    def Seek(self, offset_us: int) -> None:
        """MPRIS relative seek; AVRCP fast-forward/rewind maps here."""
        seconds = int(offset_us / 1_000_000)
        if seconds:
            LOG.info("AVRCP → Seek (%+ds)", seconds)
            _mpd_cmd("seekcur", f"{seconds:+d}")

    # -------------------------------------------------------------------------
    # D-Bus Properties interface
    # -------------------------------------------------------------------------

    @dbus.service.method(_DBUS_PROPS_IFACE, in_signature="ss", out_signature="v")
    def Get(self, iface: str, name: str):
        return self._props.get(name, dbus.String(""))

    @dbus.service.method(_DBUS_PROPS_IFACE, in_signature="s", out_signature="a{sv}")
    def GetAll(self, iface: str) -> dict:
        return self._props if iface == _MPRIS_PLAYER_IFACE else {}

    @dbus.service.method(_DBUS_PROPS_IFACE, in_signature="ssa{sv}")
    def Set(self, iface: str, name: str, value) -> None:
        # BlueZ can set these two MPRIS settings from a remote controller.
        if iface == _MPRIS_PLAYER_IFACE and name == "Shuffle":
            _mpd_cmd("random", 1 if bool(value) else 0)
        elif iface == _MPRIS_PLAYER_IFACE and name == "LoopStatus":
            loop = str(value)
            _mpd_cmd("repeat", 0 if loop == "None" else 1)
            _mpd_cmd("single", 1 if loop == "Track" else 0)

    @dbus.service.signal(_DBUS_PROPS_IFACE, signature="sa{sv}as")
    def PropertiesChanged(self, iface: str, changed: dict, invalidated: list) -> None:
        pass

    def registration_props(self) -> dict:
        """Initial MPRIS snapshot required by BlueZ's RegisterPlayer call."""
        return dict(self._props)

    # -------------------------------------------------------------------------
    # MPD state → BlueZ player properties
    # -------------------------------------------------------------------------

    def update_from_mpd(self, status: dict, song: dict, force: bool = False) -> bool:
        """Compute new props from MPD state, diff against last push, and emit
        PropertiesChanged for anything that changed.

        ``force=True`` sends every property unconditionally — used on reconnect
        and heartbeat so a freshly-connected device gets full metadata even if
        MPD state hasn't changed since last push.

        Returns False (for GLib.idle_add / GLib.timeout_add — don't repeat).
        """
        mpd_state = status.get("state", "stop")
        mpris_state = {"play": "Playing", "pause": "Paused", "stop": "Stopped"}.get(
            mpd_state, "Stopped"
        )

        # BlueZ's RegisterPlayer API consumes MPRIS 2.2 metadata, not its own
        # org.bluez.MediaPlayer1 representation.
        track: dict[str, dbus.types.Any] = {}
        if song:
            if t := song.get("title"):
                track["xesam:title"] = dbus.String(t)
            if a := song.get("artist"):
                track["xesam:artist"] = dbus.Array([dbus.String(a)], signature="s")
            if al := song.get("album"):
                track["xesam:album"] = dbus.String(al)
            if n := song.get("track"):
                try:
                    track["xesam:trackNumber"] = dbus.Int32(int(str(n).split("/")[0]))
                except (ValueError, TypeError):
                    pass
            if d := song.get("duration"):
                try:
                    track["mpris:length"] = dbus.Int64(int(float(d) * 1_000_000))
                except (ValueError, TypeError):
                    pass
        track["mpris:trackid"] = dbus.ObjectPath("/org/rpi_player/mpd/current")

        shuffle = status.get("random", "0") == "1"
        if status.get("repeat", "0") == "1":
            repeat = "Track" if status.get("single", "0") == "1" else "Playlist"
        else:
            repeat = "None"

        # Detect track change — drives whether we include Position in the push
        song_id = song.get("id", "") if song else ""
        track_changed = song_id != self._last_song_id
        if track_changed:
            self._last_song_id = song_id

        # Compute Position (ms) — push on track/state changes, and on seeks
        state_changed = mpris_state != str(self._props.get("PlaybackStatus", ""))
        push_position = track_changed or state_changed or force

        # Seek detection: if elapsed jumped more than expected drift since last push,
        # it's a seek — push the updated position so the Camry playhead tracks correctly.
        now_mono = time.monotonic()
        try:
            elapsed_f = float(status.get("elapsed", "0")) if mpd_state == "play" else 0.0
        except (ValueError, TypeError):
            elapsed_f = 0.0

        if not push_position and self._last_push_time > 0 and mpd_state == "play":
            expected = self._last_push_elapsed + (now_mono - self._last_push_time)
            if abs(elapsed_f - expected) > 3.0:
                push_position = True
                LOG.info("Seek detected: expected=%.1fs actual=%.1fs → pushing Position",
                         expected, elapsed_f)

        if push_position:
            self._last_push_elapsed = elapsed_f
            self._last_push_time = now_mono
            try:
                pos_ms = dbus.Int64(int(elapsed_f * 1_000_000))
            except (ValueError, TypeError):
                pos_ms = dbus.Int64(0)
        else:
            pos_ms = None

        # Accumulate changed properties
        new_props: dict[str, dbus.types.Any] = {
            "PlaybackStatus": dbus.String(mpris_state),
            "Metadata": dbus.Dictionary(track, signature="sv"),
            "Shuffle": dbus.Boolean(shuffle),
            "LoopStatus": dbus.String(repeat),
        }
        if pos_ms is not None:
            new_props["Position"] = pos_ms

        changed: dict[str, dbus.types.Any] = {}
        for key, val in new_props.items():
            if force or self._props.get(key) != val:
                self._props[key] = val
                changed[key]     = val

        if changed:
            title = str(track.get("xesam:title", "?"))
            LOG.info("→ BlueZ AVRCP push: status=%s track=%r changed=%s",
                     mpris_state, title, list(changed))
            self.PropertiesChanged(_MPRIS_PLAYER_IFACE, changed, [])

        return False  # GLib idle callback: don't repeat


# =============================================================================
# Bridge manager — handles lifecycle, reconnects, heartbeat
# =============================================================================

class _BridgeManager:
    """Keeps the BlueZ player registration alive and handles reconnects."""

    def __init__(self, bus: dbus.SystemBus, player: _MediaPlayer) -> None:
        self._bus    = bus
        self._player = player
        # One pending timer per device/profile operation.  Keeping this keyed
        # consistently prevents heartbeat and reconnect signals from stacking
        # overlapping ConnectProfile calls.
        self._reconnect_timers: dict[str, int] = {}

        # Watch for BlueZ appearing/disappearing (bluetoothd restart)
        self._bus.watch_name_owner(_BLUEZ_SVC, self._on_bluez_owner_changed)

        # Watch PropertiesChanged on ALL BlueZ objects: catches "Connected" flips
        self._bus.add_signal_receiver(
            self._on_dbus_properties_changed,
            dbus_interface=_DBUS_PROPS_IFACE,
            signal_name="PropertiesChanged",
            bus_name=_BLUEZ_SVC,
            path_keyword="path",
        )

        # 30-second heartbeat: unconditional full re-push
        GLib.timeout_add(_HEARTBEAT_INTERVAL_MS, self._heartbeat)

    # ---- BlueZ lifecycle ----------------------------------------------------

    def _on_bluez_owner_changed(self, owner: str) -> None:
        if owner:
            LOG.warning("BlueZ appeared (owner=%s) — re-registering player in 3 s", owner)
            GLib.timeout_add(3000, self._reregister_player)
        else:
            LOG.warning("BlueZ disappeared — player registration lost")

    def _reregister_player(self) -> bool:
        """Try to re-register with BlueZ after it restarts.

        AlreadyExists means our original RegisterPlayer call is still active
        (watch_name_owner fires even when BlueZ is already up at startup).
        Treat it as success and just push a fresh metadata snapshot.
        Any other error means BlueZ isn't fully up yet — retry in 5 s.
        """
        try:
            adapter = dbus.Interface(
                self._bus.get_object(_BLUEZ_SVC, _ADAPTER_PATH),
                _BLUEZ_MEDIA_IFACE,
            )
            adapter.RegisterPlayer(dbus.ObjectPath(_PLAYER_PATH), self._player.registration_props())
            LOG.info("Re-registered MPRIS player at %s", _PLAYER_PATH)
        except dbus.DBusException as exc:
            if "AlreadyExists" in str(exc):
                # Our registration is still alive — nothing to do except push state
                LOG.debug("Re-register: already registered (normal at startup)")
            else:
                LOG.error("Re-register failed: %s — will retry in 5 s", exc)
                GLib.timeout_add(5000, self._reregister_player)
                return False
        self._schedule_force_push("reregister")
        return False  # don't repeat the initial timeout_add

    # ---- Device connect/disconnect watching ---------------------------------

    def _on_dbus_properties_changed(
        self, iface: str, changed: dict, invalidated: list, path: str = ""
    ) -> None:
        if iface != "org.bluez.Device1":
            return
        connected = changed.get("Connected")
        if connected is None:
            return
        if bool(connected):
            LOG.info("BT device connected: %s — scheduling AVRCP connect (delays=%s ms), "
                     "metadata push in %d ms",
                     path, _AVRCP_CONNECT_DELAYS_MS, _RECONNECT_PUSH_DELAY_MS)
            self._schedule_avrcp_connect(path)
            self._schedule_force_push(path)
        else:
            LOG.info("BT device disconnected: %s", path)
            # Cancel any pending timers for this device
            for key in [path, f"avrcp:{path}"]:
                if key in self._reconnect_timers:
                    GLib.source_remove(self._reconnect_timers.pop(key))

    def _schedule_avrcp_connect(self, device_path: str, attempt: int = 0) -> None:
        """Force BlueZ to initiate the AVCTP channel to the remote device.

        Retries up to len(_AVRCP_CONNECT_DELAYS_MS) times with increasing
        delays to handle the race where A2DP hasn't fully settled yet.
        Stops retrying once ConnectProfile succeeds or reports AlreadyConnected.
        """
        if attempt >= len(_AVRCP_CONNECT_DELAYS_MS):
            LOG.warning("AVRCP ConnectProfile: all %d attempts exhausted for %s",
                        len(_AVRCP_CONNECT_DELAYS_MS), device_path)
            return
        delay = _AVRCP_CONNECT_DELAYS_MS[attempt]
        key = f"avrcp:{device_path}"
        if key in self._reconnect_timers:
            return
        timer_id = GLib.timeout_add(
            delay,
            lambda: self._do_avrcp_connect(device_path, key, attempt),
        )
        self._reconnect_timers[key] = timer_id
        LOG.info("AVRCP ConnectProfile attempt %d scheduled in %d ms for %s",
                 attempt + 1, delay, device_path)

    def _do_avrcp_connect(self, device_path: str, key: str, attempt: int) -> bool:
        self._reconnect_timers.pop(key, None)
        try:
            props = dbus.Interface(
                self._bus.get_object(_BLUEZ_SVC, device_path),
                _DBUS_PROPS_IFACE,
            )
            remote_uuids = {str(uuid).lower() for uuid in props.Get("org.bluez.Device1", "UUIDs")}
            if _AVRCP_CONTROLLER_UUID not in remote_uuids:
                LOG.info("AVRCP Controller UUID not yet advertised by %s (attempt %d)",
                         device_path, attempt + 1)
                self._schedule_avrcp_connect(device_path, attempt + 1)
                return False
            device = dbus.Interface(
                self._bus.get_object(_BLUEZ_SVC, device_path),
                "org.bluez.Device1",
            )
            device.ConnectProfile(_AVRCP_CONTROLLER_UUID)
            LOG.info("AVRCP ConnectProfile attempt %d succeeded for %s",
                     attempt + 1, device_path)
            # Success — no further retries needed
        except dbus.DBusException as exc:
            err = str(exc)
            if any(s in err for s in ("AlreadyConnected", "Already Connected", "InProgress")):
                LOG.info("AVRCP already connected/in-progress for %s (attempt %d): %s",
                         device_path, attempt + 1, exc)
                # Already connected — no further retries needed
            else:
                LOG.warning("AVRCP ConnectProfile attempt %d failed for %s: %s",
                            attempt + 1, device_path, exc)
                # Schedule next retry
                self._schedule_avrcp_connect(device_path, attempt + 1)
        return False

    def _schedule_force_push(self, key: str) -> None:
        """Cancel any existing push timer for ``key`` and schedule a new one."""
        if key in self._reconnect_timers:
            GLib.source_remove(self._reconnect_timers[key])
        timer_id = GLib.timeout_add(
            _RECONNECT_PUSH_DELAY_MS,
            lambda: self._do_force_push(key),
        )
        self._reconnect_timers[key] = timer_id

    def _do_force_push(self, key: str) -> bool:
        self._reconnect_timers.pop(key, None)
        LOG.info("Force metadata push (trigger=%s)", key)
        _push_current_mpd_state(self._player, force=True)
        return False

    # ---- Heartbeat ----------------------------------------------------------

    def _heartbeat(self) -> bool:
        """30-second heartbeat: re-push the state in case an event was lost."""
        LOG.debug("Heartbeat: re-pushing metadata to all AVRCP devices")
        _push_current_mpd_state(self._player, force=True)
        return True  # repeat


# =============================================================================
# MPD helpers
# =============================================================================

def _mpd_cmd(command: str, *args) -> None:
    """One-shot MPD command: connect, run, disconnect."""
    try:
        c = _mpd.MPDClient()
        c.connect(_MPD_HOST, _MPD_PORT)
        getattr(c, command)(*args)
        c.close()
        c.disconnect()
    except Exception as exc:
        LOG.warning("MPD command '%s %s' failed: %s", command, args, exc)


def _push_current_mpd_state(player: _MediaPlayer, force: bool = False) -> None:
    """Read current MPD state synchronously and push it to BlueZ.

    ID3 fallback: if the song's title or artist tag is blank, derive them from
    the filename using player.id3_fallback so the Camry head unit shows
    something useful instead of "(Unknown)".
    """
    try:
        c = _mpd.MPDClient()
        c.connect(_MPD_HOST, _MPD_PORT)
        status = c.status()
        song   = c.currentsong()
        c.close()
        c.disconnect()
        # Enrich missing ID3 tags from filename before pushing to BlueZ.
        if song and _HAS_ID3_FALLBACK:
            filename = song.get("file", "")
            title = song.get("title", "")
            artist = song.get("artist", "")
            enriched_title, enriched_artist = _id3_enrich(title, artist, filename)
            if enriched_title != title or enriched_artist != artist:
                song = dict(song)
                if enriched_title:
                    song["title"] = enriched_title
                if enriched_artist:
                    song["artist"] = enriched_artist
                elif "artist" in song:
                    # Explicitly blank artist is better than "(Unknown)"
                    song["artist"] = ""
        player.update_from_mpd(status, song, force=force)
    except Exception as exc:
        LOG.warning("MPD state read failed: %s", exc)


def _mpd_watcher(player: _MediaPlayer) -> None:
    """Background thread: blocks on MPD idle events, pushes state changes."""
    c = _mpd.MPDClient()
    while True:
        try:
            c.connect(_MPD_HOST, _MPD_PORT)
            LOG.info("MPD idle watcher connected")
            # Push initial state
            GLib.idle_add(player.update_from_mpd, c.status(), c.currentsong(), False)
            while True:
                c.idle("player", "mixer", "options")
                GLib.idle_add(player.update_from_mpd, c.status(), c.currentsong(), False)
        except Exception as exc:
            LOG.warning("MPD watcher error: %s — reconnecting in 3 s", exc)
            try:
                c.disconnect()
            except Exception:
                pass
            time.sleep(3)


# =============================================================================
# Entry point
# =============================================================================

def main() -> None:
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()

    # Register our MPRIS player.  BlueZ translates it to AVRCP Target for a
    # remote AVRCP Controller such as the Camry head unit.
    player = _MediaPlayer(bus, _PLAYER_PATH)

    adapter = dbus.Interface(
        bus.get_object(_BLUEZ_SVC, _ADAPTER_PATH),
        _BLUEZ_MEDIA_IFACE,
    )
    try:
        adapter.RegisterPlayer(dbus.ObjectPath(_PLAYER_PATH), player.registration_props())
        LOG.info("Registered MPRIS player at %s", _PLAYER_PATH)
    except dbus.DBusException as exc:
        LOG.error("RegisterPlayer failed: %s", exc)
        sys.exit(1)

    # Lifecycle manager: reconnect watching + heartbeat
    _BridgeManager(bus, player)

    # MPD idle watcher in background thread
    loop = GLib.MainLoop()
    watcher = threading.Thread(
        target=_mpd_watcher, args=(player,), daemon=True, name="mpd-idle"
    )
    watcher.start()

    LOG.info(
        "AVRCP bridge ready — AVRCP Controller devices can now control MPD "
        "(heartbeat every %d s, reconnect push delay %d ms)",
        _HEARTBEAT_INTERVAL_MS // 1000,
        _RECONNECT_PUSH_DELAY_MS,
    )
    try:
        loop.run()
    finally:
        try:
            adapter.UnregisterPlayer(dbus.ObjectPath(_PLAYER_PATH))
        except Exception:
            pass
        LOG.info("AVRCP bridge stopped")


if __name__ == "__main__":
    main()
